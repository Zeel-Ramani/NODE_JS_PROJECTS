<%- include('blog/header') %>

    <style>
        .edit-wrap {
            max-width: 750px;
            margin: 60px auto;
            background: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, .2)
        }

        .edit-wrap h2 {
            text-align: center;
            font-weight: 700;
            margin-bottom: 30px
        }

        .form-control,
        select {
            border-radius: 14px;
            padding: 10px
        }

        .btn-main {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            border: none;
            color: #fff;
            border-radius: 30px;
            padding: 12px;
            font-weight: 600
        }
    </style>

    <div class="edit-wrap">
        <h2>Edit Blog</h2>

        <form action="/blogs/edit-blog/<%= blog._id %>" method="POST" enctype="multipart/form-data">
            <input class="form-control mb-3" name="title" value="<%= blog.title %>" required>
            <textarea class="form-control mb-3" rows="5" name="content" required><%= blog.content %></textarea>

            <select class="form-control mb-3" name="category">
                <option <%=blog.category=="Technology" ?"selected":"" %>>Technology</option>
                <option <%=blog.category=="Health" ?"selected":"" %>>Health</option>
                <option <%=blog.category=="Education" ?"selected":"" %>>Education</option>
                <option <%=blog.category=="Travel" ?"selected":"" %>>Travel</option>
                <option <%=blog.category=="Adventure" ?"selected":"" %>>Adventure</option>
                <option <%=blog.category=="Marketing" ?"selected":"" %>>Marketing</option>
                <option <%=blog.category=="Entertainment" ?"selected":"" %>>Entertainment</option>
                <option <%=blog.category=="Lifestyle" ?"selected":"" %>>Lifestyle</option>
                <option <%=blog.category=="Other" ?"selected":"" %>>Other</option>
            </select>

            <input class="form-control mb-3" name="tags" value="<%= blog.tags.join(', ') %>">

            <% if(blog.blogImage){ %>
                <img src="/uploads/<%= blog.blogImage %>" style="max-width:200px;border-radius:14px" class="mb-3">
                <% } %>

                    <input type="file" class="form-control mb-4" name="blogImage">

                    <button class="btn btn-main w-100">Update Blog</button>
        </form>
    </div>

    <%- include('blog/footer') %>
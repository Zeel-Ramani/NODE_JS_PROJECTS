<%- include('blog/header') %>

    <style>
        .form-wrap {
            max-width: 750px;
            margin: 60px auto;
            background: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0, 0, 0, .2)
        }

        .form-wrap h2 {
            text-align: center;
            font-weight: 700;
            margin-bottom: 30px
        }

        .form-control,
        select {
            border-radius: 14px;
            padding: 10px
        }

        .btn-main {
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: #fff;
            border: none;
            border-radius: 30px;
            padding: 12px;
            font-weight: 600
        }
    </style>

    <div class="form-wrap">
        <h2>Add New Blog</h2>

        <form action="/blogs/add-blog" method="POST" enctype="multipart/form-data">
            <input class="form-control mb-3" name="title" placeholder="Blog Title" required>
            <textarea class="form-control mb-3" rows="5" name="content" placeholder="Blog Content" required></textarea>
            <input class="form-control mb-3" name="author" placeholder="Author Name" required>

            <select name="category" required>
                <% categories.forEach(cat=> { %>
                    <option value="<%= cat._id %>">
                        <%= cat.name %>
                    </option>
                    <% }) %>
            </select>

            <input type="file" class="form-control mb-3" name="blogImage">
            <input class="form-control mb-4" name="tags" placeholder="Tags (comma separated)">

            <button class="btn btn-main w-100">Publish Blog</button>
        </form>
    </div>

    <%- include('blog/footer') %>
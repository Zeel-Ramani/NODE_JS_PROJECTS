<!DOCTYPE html>
<html>
<head>
<title>Dashboard</title>

<style>
body{
 font-family:Arial;
 background:#f1f5f9;
 margin:0;
}

.nav{
 background:#1e293b;
 padding:15px;
 text-align:center;
}

.nav a{
 color:white;
 margin:0 15px;
 text-decoration:none;
 font-weight:bold;
}

.container{
 width:80%;
 margin:auto;
 background:white;
 margin-top:20px;
 padding:20px;
 border-radius:10px;
 box-shadow:0 0 10px gray;
}

input{
 padding:8px;
 width:200px;
 margin:5px;
}

button{
 padding:8px 20px;
 background:#2563eb;
 color:white;
 border:none;
 border-radius:5px;
}

.card{
 background:#f1f5f9;
 padding:10px;
 margin:8px;
 border-radius:5px;
 display:flex;
 justify-content:space-between;
}
</style>

</head>
<body>

<div class="nav">
<a href="/dashboard">Dashboard</a>
<a href="/my-products">My Products</a>
<a href="/categories">Categories</a>
<a href="/logout">Logout</a>
</div>

<div class="container">

<h2 align="center">Dashboard</h2>

<h3>Add Product</h3>

<form method="post" action="/product/add">

<input name="name" placeholder="Name" required>

<input name="price" placeholder="Price" required>

<input name="category" placeholder="Category">

<button>Add</button>

</form>

<hr>

<h3>All Products</h3>

<% products.forEach(p=>{ %>

<div class="card">

<span><%=p.name%></span>

<span>
₹<%=p.price%> - <%=p.user.username%>

<a href="/product/edit/<%=p._id%>">✏️</a>

<a href="/product/delete/<%=p._id%>"
 onclick="return confirm('Delete?')">🗑️</a>
</span>

</div>

<% }) %>

</div>

</body>
</html>

<!DOCTYPE html>
<html>

<head>
    <title>My Products</title>

    <style>
        body {
            font-family: Arial;
            background: #f1f5f9;
            margin: 0;
        }

        .nav {
            background: #1e293b;
            padding: 15px;
            text-align: center;
        }

        .nav a {
            color: white;
            margin: 0 15px;
            text-decoration: none;
            font-weight: bold;
        }

        .container {
            width: 70%;
            margin: auto;
            background: white;
            margin-top: 20px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px gray;
        }

        .card {
            background: #f1f5f9;
            padding: 10px;
            margin: 8px;
            border-radius: 5px;
            display: flex;
            justify-content: space-between;
        }
    </style>

</head>

<body>

    <div class="nav">
        <a href="/dashboard">Dashboard</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="container">

        <h2 align="center">My Products</h2>

        <% products.forEach(p=>{ %>

            <div class="card">

                <img src="<%=p.image%>" width="60" height="60">

                <span>
                    <%=p.name%>
                </span>

                <span>₹<%=p.price%></span>

            </div>


            <% }) %>

    </div>

</body>

</html>